# ---- Storage: must match the Node backend's setting ----
# false (default) = local JSON files in DATA_DIR
# true            = MongoDB at MONGO_URI
USE_MONGO=false
DATA_DIR=output

# Used only when USE_MONGO=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=teleconsult_dummy

# ---- Local LLM (Ollama running on THIS machine) ----
# No Kaggle, no ngrok. Just run `ollama serve` locally.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

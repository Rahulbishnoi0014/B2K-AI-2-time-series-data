# ---- Storage: flip this one flag to switch the WHOLE system ----
# false (default) = local JSON files shared with the Python AI service
# true            = MongoDB (local or remote) at MONGO_URI
USE_MONGO=false

# Where the JSON files live (must match the Python service's DATA_DIR).
# Default points at the AI service's output/ folder.
DATA_DIR=../ai-service/output

# Used only when USE_MONGO=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=teleconsult_dummy

# Server
PORT=8000
AI_SERVICE_URL=http://localhost:8001
